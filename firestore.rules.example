rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ★ 幹事のGoogleアカウントのメールアドレスに書き換えてください
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email == 'YOUR_ADMIN_EMAIL@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOpen() {
      return get(/databases/$(database)/documents/config/state).data.open == true;
    }

    // 受付状態: 誰でも読める / 幹事だけ変更可
    match /config/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 問題文・選択肢: 受付中のみ参加者が読める（事前の閲覧を防止） / 幹事は常に読み書き可
    match /questions/{id} {
      allow read: if request.auth != null && (isAdmin() || isOpen());
      allow write: if isAdmin();
    }

    // 正解: 幹事だけ
    match /secret/{id} {
      allow read, write: if isAdmin();
    }

    // 参加者: 自分のIDで1回だけ登録 / 自分のものと幹事は読める
    match /participants/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'joinedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.joinedAt == request.time;
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, delete: if isAdmin();
      allow get: if isAdmin();
    }

    // 回答: 受付中のみ、自分のIDで1回だけ作成可（update不可＝上書き禁止）
    match /responses/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && isOpen()
        && request.resource.data.keys().hasOnly(['name', 'choices', 'times', 'submittedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.choices is list && request.resource.data.choices.size() == 5
        && request.resource.data.times is list && request.resource.data.times.size() == 5
        && request.resource.data.submittedAt == request.time;
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, delete: if isAdmin();
      allow get: if isAdmin();
    }
  }
}
